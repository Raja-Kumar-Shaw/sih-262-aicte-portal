# AICTE Institutional Approval Workflow Automation & Compliance System
# Environment Configuration Template

# Server Port
PORT=5000

# Node Environment
NODE_ENV=development

# JWT Secret for Session Authentication (Change in production)
JWT_SECRET=aicte_portal_super_secret_jwt_key_2026

# Document Upload Limit (in bytes: 10MB)
MAX_FILE_SIZE=10485760

# Optional Tesseract OCR Language Setting (eng, hin)
OCR_LANG=eng

# SLA Threshold Defaults (in Days)
DEFAULT_SLA_SCRUTINY_DAYS=7
DEFAULT_SLA_CLARIFICATION_DAYS=7
DEFAULT_SLA_TECHNICAL_REVIEW_DAYS=10
