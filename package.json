{
  "name": "aicte-approval-automation",
  "version": "1.0.0",
  "description": "Integrated AICTE Approval Workflow Automation, Compliance Monitoring and Alert Management System",
  "main": "server/index.ts",
  "type": "module",
  "scripts": {
    "build": "vite build",
    "start": "tsx server/index.ts",
    "server": "tsx server/index.ts",
    "client": "vite",
    "dev": "concurrently -k -p \"[{name}]\" -n \"SERVER,CLIENT\" -c \"blue.bold,magenta.bold\" \"tsx server/index.ts\" \"vite --host\"",
    "seed": "tsx server/db/seedRunner.ts"
  },
  "keywords": [
    "aicte",
    "approval-workflow",
    "compliance-monitoring"
  ],
  "author": "AICTE Approval Bureau",
  "license": "ISC",
  "dependencies": {
    "bcryptjs": "^3.0.2",
    "cors": "^2.8.5",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.2",
    "lucide-react": "^1.16.0",
    "multer": "^1.4.5-lts.1",
    "pdf-parse": "^1.1.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.3.0",
    "recharts": "^2.15.1"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.9",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.13.10",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2",
    "vite": "^6.2.1"
  }
}
